# =============================================================================
# NipoAI — Environment Variables
# =============================================================================
#
# シークレットは Infisical で一元管理しています。
#
# ■ 開発時の起動方法（推奨）:
#   pnpm dev:secrets
#   → Infisical から自動でシークレットを注入して Next.js を起動
#
# ■ Infisical CLI の初回設定:
#   infisical login
#   → ブラウザで認証
#
# ■ .env.local を手動で使いたい場合:
#   cp .env.local.example .env.local
#   → 値を埋めて pnpm dev で起動
#
# =============================================================================

# -- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -- Slack OAuth & Events -----------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# -- Anthropic (AI report generation) -----------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -- Stripe (billing) ---------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -- Cron authentication ------------------------------------------------------
# Shared secret used to authenticate /api/cron/* endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# -- Encryption ---------------------------------------------------------------
# AES-256-GCM key for encrypting sensitive data (e.g. Slack bot tokens).
# Must be exactly 32 bytes, hex-encoded (64 hex characters).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# -- Application URL -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
